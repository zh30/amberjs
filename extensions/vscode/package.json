{
  "name": "amberjs-tools",
  "displayName": "Amber Developer Tools",
  "description": "Language Server, CDP Debugger, oxc Formatter & Deployment Toolkit for Amber",
  "version": "1.16.0",
  "publisher": "zh30",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "runtime",
    "amberjs",
    "debugger",
    "performance"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:amberjs.runScript",
    "onCommand:amberjs.debugScript",
    "onCommand:amberjs.formatDocument",
    "onCommand:amberjs.exportTypes",
    "onCommand:amberjs.deploy",
    "onDebug:amberjs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "amberjs",
        "aliases": ["Amber", "amberjs"],
        "extensions": [".amberjs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "amberjs",
        "scopeName": "source.amberjs",
        "path": "./syntaxes/amberjs.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Amber Runtime",
      "properties": {
        "amberjs.runtimePath": {
          "type": "string",
          "default": "amber",
          "description": "Path to the Amber executable",
          "order": 1
        },
        "amberjs.debugPort": {
          "type": "number",
          "default": 9229,
          "description": "Debug port for Amber inspector",
          "order": 2
        },
        "amberjs.enableTypeChecking": {
          "type": "boolean",
          "default": true,
          "description": "Enable TypeScript type checking for Amber scripts",
          "order": 3
        },
        "amberjs.maxMemory": {
          "type": "string",
          "default": "512m",
          "description": "Maximum memory allocation for Amber runtime",
          "order": 4
        },
        "amberjs.enableExperimentalFeatures": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental Amber features",
          "order": 5
        }
      }
    },
    "commands": [
      {
        "command": "amberjs.runScript",
        "title": "Run Amber Script",
        "category": "Amber"
      },
      {
        "command": "amberjs.debugScript",
        "title": "Debug Amber Script",
        "category": "Amber"
      },
      {
        "command": "amberjs.formatDocument",
        "title": "Format Document with OXC (amber fmt)",
        "category": "Amber"
      },
      {
        "command": "amberjs.exportTypes",
        "title": "Export TypeScript Definitions (amber types)",
        "category": "Amber"
      },
      {
        "command": "amberjs.deploy",
        "title": "Deploy Application Scaffolding (amber deploy)",
        "category": "Amber"
      },
      {
        "command": "amberjs.showPerformanceReport",
        "title": "Show Performance Report",
        "category": "Amber"
      },
      {
        "command": "amberjs.installRuntime",
        "title": "Install Amber Runtime",
        "category": "Amber"
      }
    ],
    "keybindings": [
      {
        "command": "amberjs.runScript",
        "key": "f5",
        "when": "editorTextFocus && resourceExtname == .js"
      },
      {
        "command": "amberjs.debugScript",
        "key": "f6",
        "when": "editorTextFocus && resourceExtname == .js"
      }
    ],
    "debuggers": [
      {
        "type": "amberjs",
        "label": "Amber",
        "program": "./out/debug/adapter.js",
        "runtimeExecutable": "${config:amberjs.runtimePath}",
        "runtimeArgs": ["debug", "--port", "${config:amberjs.debugPort}"],
        "port": "${config:amberjs.debugPort}",
        "stopOnEntry": true,
        "sourceMaps": true,
        "pathMappings": [],
        "restart": true,
        "console": "integratedTerminal",
        "variables": {
          "amberjsRuntime": "${command:amberjs.selectRuntime}"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "amberjs.runScript",
          "when": "resourceExtname == .js || resourceExtname == .ts || resourceExtname == .amberjs",
          "group": "amberjs@1"
        },
        {
          "command": "amberjs.debugScript",
          "when": "resourceExtname == .js || resourceExtname == .ts || resourceExtname == .amberjs",
          "group": "amberjs@2"
        }
      ],
      "explorer/context": [
        {
          "command": "amberjs.runScript",
          "when": "resourceExtname == .js || resourceExtname == .ts || resourceExtname == .amberjs",
          "group": "amberjs@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "18.x",
    "@types/mocha": "^10.0.0",
    "@types/chai": "^4.3.0",
    "typescript": "^4.9.4",
    "ts-node": "^10.9.1",
    "mocha": "^10.2.0",
    "chai": "^4.3.7",
    "eslint": "^8.34.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.61.0",
    "@vscode/debugprotocol": "^1.61.0",
    "vscode-languageclient": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zh30/amberjs.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zh30/amberjs/issues"
  },
  "homepage": "https://github.com/zh30/amberjs"
}
